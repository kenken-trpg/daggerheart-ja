        "Legendary Beast": {
            "_note": "Legendary Beast",
            "name": "伝説の獣",
            "effects": {
                "cL4kH57pf2nGIxaK": {
                    "name": "ビーストフォーム変身",
                    "description": "<p>ティア1のビーストフォームの選択肢を1つ選び、その生き物のより大きく、より強力な姿になります。この姿のあいだ、元の姿の特性と特徴をすべて保ち、さらに以下のボーナスを得ます。</p><ul><li><p>ダメージロールに＋6のボーナス</p></li><li><p>この姿が使う特性に＋1のボーナス</p></li><li><p>回避値に＋2のボーナス</p></li></ul>"
                }
            }
        },
