                },
                "ctXYwil2D1zfsekT": {
                    "name": "大地の噴出",
                    "effects": {
                        "9PsnogEPsp1OOK64": {
                            "name": "大地の噴出"
                        }
                    }
                },
                "UpFsnlbZkyvM2Ftv": {
                    "description": "<p>@Lookup[@name]の正面にいる近距離内のすべての対象に攻撃を行います。@Lookup[@name]が成功した対象は<strong>2d6</strong>の物理ダメージを受け、恩恵を受けずに鎧スロットを1つマークしなければなりません（ダメージ軽減のために鎧を使うことは依然として可能です）。鎧スロットをマークできない場合、HPを追加で1マークし、あなたは恐怖を1得ます。</p><p>@Template[type:inFront|range:c]</p>"
                }
            }
        },
