        "Acid Burrower": {
            "_note": "Acid Burrower",
            "name": "酸性穴掘り",
            "description": "<p>掘削用の爪と酸性の血を持つ、馬ほどの大きさの昆虫。</p>",
            "motivesAndTactics": "穴を掘る、引きずり込む、捕食する、位置を変える",
            "attack": {
                "name": "爪"
            },
            "experiences": {
