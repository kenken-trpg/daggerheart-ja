        },
        "Blinding Orb": {
            "_note": "Blinding Orb",
            "name": "目潰しの宝珠",
            "description": "<p>この宝珠を起動して、強い光の閃光を生み出せます。近距離以内のすべての対象は、HPをマークするまで脆弱になります。</p><p>@Template[type:emanation|range:c]</p>",
