    "entries": {
        "Accomplished": {
            "_note": "Accomplished",
            "name": "熟達者",
            "description": "<p>アクセスを持つドメインから、自分のレベル以下のドメインカードを追加で1枚取ります。</p>"
        },
        "Act of Reprisal": {
            "_note": "Act of Reprisal",
            "name": "報復の一撃",
            "description": "<p>近接射程内の味方が敵対者からダメージを受けたとき、その敵対者に対する次の攻撃が成功するまで、習熟に＋1のボーナスを得ます。</p>",
            "actions": {
                "yalzg4VRmZvakshJ": {
                    "name": "敵対者をマーク"
                }
            },
            "effects": {
                "9Uo0yOYGn3vandPp": {
                    "name": "報復の一撃",
                    "durationDescription": "<p>その敵対者に対する次の攻撃が成功するまで。</p>"
                }
            }
        },
        "Adder's Blessing": {
            "_note": "Adder's Blessing",
            "name": "蝮の祝福",
            "description": "<p>毒およびその他の毒物に対して耐性を持ちます。</p>"
        },
        "Adept": {
            "_note": "Adept",
            "name": "練達",
            "description": "<p>経験を活用するとき、希望を消費する代わりに<strong>ストレスを1マーク</strong>できます。そうした場合、そのロールの経験修正値を2倍にします。</p>",
            "actions": {
                "FOl7kaOG6DFWIpMm": {
                    "name": "ストレスをマーク"
                }
            }
        },
        "Adrenaline": {
            "_note": "Adrenaline",
            "name": "アドレナリン",
            "description": "<p>脆弱である間、ダメージロールに自分のレベルを加えます。</p>",
            "effects": {
                "HMx9uZ54mvMiH95x": {
                    "name": "アドレナリン",
                    "description": "<p>脆弱である間、ダメージロールに自分のレベルを加えます。</p>"
                }
            }
        },
        "Advanced Training": {
            "_note": "Advanced Training",
            "name": "上級訓練",
            "description": "<p>相棒のレベルアップ選択肢を追加で2つ選びます。</p>",
            "effects": {
