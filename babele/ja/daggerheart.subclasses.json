                }
            }
        },
        "Defensive": {
            "_note": "Defensive",
            "name": "防御的",
            "description": "<p>近接射程内からあなたを対象とする攻撃ロールは、攻撃者がストレスを1マークして打ち消さない限り、不利になります。</p>",
            "actions": {
                "syX0fPaPNwVqpwBP": {
