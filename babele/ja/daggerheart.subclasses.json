        "Battle-Bonded": {
            "_note": "Battle-Bonded",
            "name": "戦の絆",
            "description": "<p>敵対者が相棒の近接射程内にいる状態で自分を攻撃したとき、その攻撃に対する回避値に＋2のボーナスを得ます。</p>",
            "effects": {
                "IZhakv6EuG8DO4a3": {
                    "name": "戦の絆",
                    "description": "<p>敵対者が相棒の近接射程内にいる状態で自分を攻撃したとき、その攻撃に対する回避値に＋2のボーナスを得ます。</p>",
                    "durationDescription": "<p>その攻撃に対して。</p>"
                }
            }
        },
        "Battle Ritual": {
            "_note": "Battle Ritual",
            "name": "戦いの儀式",
            "description": "<p>大休憩ごとに1回、とてつもなく危険なことに挑む前、または明らかに自分より格上の敵と対峙する前に、どんな儀式を行うか、どんな準備をするかを描写します。そうしたとき、ストレスを2つ消し、希望を2得ます。</p>",
            "actions": {
                "UdZx74Vcz6ip4Plh": {
                    "name": "備える"
                }
            }
        },
        "Battlemage": {
            "_note": "Battlemage",
            "name": "戦闘魔道士",
            "description": "<p>戦場で征服されざる力となるべく研究を重ねてきました。HPスロットを1つ追加で得ます。</p>",
            "effects": {
                "6jjKzvBxAJTHHGoX": {
                    "name": "戦闘魔道士",
                    "description": "<p>HPスロットを1つ追加で得ます。</p>"
