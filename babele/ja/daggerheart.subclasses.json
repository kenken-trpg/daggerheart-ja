                }
            }
        },
        "Damage Sink": {
            "_note": "Damage Sink",
            "name": "ダメージの受け皿",
            "description": "<p>休憩ごとに1回、<strong>恩寵を1消費</strong>して受けるダメージを半減できます。</p>",
