{
    "Actor": {
        "_identity": {
            "export": [
                "name",
                "_id"
            ],
            "match": [
                "_id",
                "name"
            ]
        },
        "name": "name",
        "description": "system.description",
        "motivesAndTactics": "system.motivesAndTactics",
        "impulses": "system.impulses",
        "notes": "system.notes",
        "attack": {
            "path": "system.attack",
            "converter": "structured",
            "cardinality": "one",
            "mapping": {
                "name": "name",
                "description": "description",
                "areas": {
                    "path": "areas",
                    "converter": "structured",
                    "container": "array",
                    "cardinality": "many",
                    "mapping": {
                        "name": "name"
                    }
                },
                "countdown": {
                    "path": "countdown",
                    "converter": "structured",
                    "container": "array",
                    "cardinality": "many",
                    "mapping": {
                        "name": "name"
                    }
                }
            }
        },
        "experiences": {
            "path": "system.experiences",
            "converter": "structured",
            "container": "keyed",
            "mapping": {
                "name": "name",
                "description": "description"
            }
        },
        "potentialAdversaries": {
            "path": "system.potentialAdversaries",
            "converter": "structured",
            "container": "keyed",
            "mapping": {
                "label": "label"
            }
        },
        "items": {
            "path": "items",
            "converter": "document",
            "documentType": "Item",
            "cardinality": "many"
        },
        "effects": {
            "path": "effects",
            "converter": "document",
            "documentType": "ActiveEffect",
            "cardinality": "many"
        }
    },
    "Item": {
        "_identity": {
            "export": [
                "name",
                "_id"
            ],
            "match": [
                "_id",
                "name"
            ]
        },
        "name": "name",
        "description": "system.description",
        "actions": {
            "path": "system.actions",
            "converter": "structured",
            "container": "keyed",
            "mapping": {
                "name": "name",
                "description": "description",
                "areas": {
                    "path": "areas",
                    "converter": "structured",
                    "container": "array",
                    "cardinality": "many",
                    "mapping": {
                        "name": "name"
                    }
                },
                "countdown": {
                    "path": "countdown",
                    "converter": "structured",
                    "container": "array",
                    "cardinality": "many",
                    "mapping": {
                        "name": "name"
                    }
                }
            }
        },
        "attack": {
            "path": "system.attack",
            "converter": "structured",
            "cardinality": "one",
            "mapping": {
                "name": "name",
                "description": "description",
                "areas": {
                    "path": "areas",
                    "converter": "structured",
                    "container": "array",
                    "cardinality": "many",
                    "mapping": {
                        "name": "name"
                    }
                },
                "countdown": {
                    "path": "countdown",
                    "converter": "structured",
                    "container": "array",
                    "cardinality": "many",
                    "mapping": {
                        "name": "name"
                    }
                }
            }
        },
        "examples": "system.examples",
        "advantageOn": {
            "path": "system.advantageOn",
            "converter": "structured",
            "container": "keyed",
            "mapping": {
                "value": "value"
            }
        },
        "backgroundQuestions": {
            "path": "system.backgroundQuestions",
            "converter": "stringArray"
        },
        "connections": {
            "path": "system.connections",
            "converter": "stringArray"
        },
        "levelupOptionTiers": {
            "path": "system.levelupOptionTiers",
            "converter": "leafFields",
            "fields": [
                "label"
            ]
        }
    },
    "ActiveEffect": {
        "_identity": {
            "export": [
                "name",
                "_id"
            ],
            "match": [
                "_id",
                "name"
            ]
        },
        "name": "name",
        "description": "description",
        "changes": {
            "path": "system.changes",
            "converter": "structured",
            "container": "array",
            "cardinality": "many",
            "valuePath": "value",
            "mapping": {
                "name": "value.name"
            }
        },
        "durationDescription": "system.duration.description"
    }
}
